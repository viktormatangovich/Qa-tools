{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "ru",
  "version": "2.2.1",
  "description": "__MSG_appDesc__",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting",
    "clipboardWrite",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_openTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
